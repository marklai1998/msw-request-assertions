{
  "name": "msw-request-assertions",
  "version": "3.0.0",
  "description": "Request assertions for MSW",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest/vitest.d.ts",
      "default": "./dist/vitest/index.js"
    },
    "./jest": {
      "types": "./dist/jest/jest.d.ts",
      "default": "./dist/jest/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "vitest": [
        "./dist/vitest/vitest.d.ts"
      ],
      "jest": [
        "./dist/jest/jest.d.ts"
      ],
      "*": []
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marklai1998/msw-request-assertions"
  },
  "keywords": [
    "msw",
    "vitest",
    "vitest-plugin",
    "api",
    "mock",
    "mocking",
    "testing"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/marklai1998/msw-request-assertion/issues"
  },
  "homepage": "https://github.com/marklai1998/msw-request-assertion#readme",
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "21.2.4",
    "@faker-js/faker": "10.6.0",
    "@jest/globals": "30.5.2",
    "@marklai/shared-config-biome": "1.0.2",
    "@marklai/shared-config-commitlint": "1.1.3",
    "@marklai/shared-config-typescript": "1.1.2",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "graphql": "17.1.0",
    "lefthook": "2.2.2",
    "msw": "3.0.4",
    "tsdown": "0.23.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wretch": "3.0.9"
  },
  "peerDependencies": {
    "jest": "^30.0.4",
    "graphql": ">=16",
    "msw": "^3.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "graphql": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "jest": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  }
}
